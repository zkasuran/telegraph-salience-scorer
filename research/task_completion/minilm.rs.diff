+/// embB (full transformer) cosine between two arbitrary texts. Used for the
+/// (question, answer) relevance term the champion weights at 0.10; on TASK_COMPLETION
+/// the question carries the task so this term tracks task-relevance directly.
+pub fn embed_cos_b(x: &[u8], y: &[u8]) -> f32 {
+    let mut xa = zero_out(); let mut xb = zero_out();
+    let mut ya = zero_out(); let mut yb = zero_out();
+    encode(x, &mut xa, &mut xb);
+    encode(y, &mut ya, &mut yb);
+    dotc(&xb, &yb)
+}
